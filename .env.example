# ========================================================
# FRONTEND ENVIRONMENT VARIABLES (Vite / Client-side)
# Put these in .env.local for local testing, or in Vercel Project Settings
# ========================================================

# Facebook App ID (Meta Developer Console)
VITE_FB_APP_ID="1469533411730984"

# Google Sheets Webhook URL (Google Apps Script Web App Deployment URL)
# Example: https://script.google.com/macros/s/AKfycb.../exec
VITE_RSVP_WEBHOOK_URL=""


# ========================================================
# BACKEND ENVIRONMENT VARIABLES (Vercel Serverless Functions)
# Configure these in: Vercel Dashboard -> Project Settings -> Environment Variables
# ========================================================

# Facebook App ID and App Secret for server-side token validation (/api/fb-verify)
FB_APP_ID="1469533411730984"
FB_APP_SECRET=""
